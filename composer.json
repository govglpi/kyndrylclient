{
  "name": "plss/glpi-kyndryl-client",
  "description": "GLPI plugin for Kyndryl API Integration",
  "type": "glpi-plugin",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Matheus Schmidt",
      "email": "matheus.schmidt@plss.com.br"
    }
  ],
  "require": {
    "php": ">=8.0",
    "guzzlehttp/guzzle": "^7.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "GlpiPlugin\\KyndrylClient\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "GlpiPlugin\\KyndrylClient\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}